<Window x:Class="GUI_PCRSystem.Menu.NewFileSizesSetter"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_PCRSystem.Menu"
        xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        mc:Ignorable="d"
        Title="NewFileSizesSetter" Height="450" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="5" HorizontalAlignment="Center" Grid.Row="0" Text="Persons linear hash file:" FontWeight="Bold" FontSize="15"/>
        <TextBlock Margin="5" HorizontalAlignment="Center" Grid.Row="1" Text="Main file block size (bytes):" />
        

        <xctk:IntegerUpDown Grid.Row="2"
         Width="150"
         Margin="0 5 0 15"
         x:Name="PersonsMainBlockSize"/>


        <TextBlock Margin="5" HorizontalAlignment="Center" Grid.Row="3" Text="Overflow file block size (bytes):" />

        <xctk:IntegerUpDown Grid.Row="4"
         Width="150"
         Margin="0 5 0 15"
         x:Name="PersonsOverflowBlockSize"/>

        
        
        <TextBlock Margin="5" HorizontalAlignment="Center" Grid.Row="5" Text="PCR tests linear hash file:" FontWeight="Bold" FontSize="15"/>
        <TextBlock Margin="5" HorizontalAlignment="Center" Grid.Row="6" Text="Main file block size (bytes):" />


        <xctk:IntegerUpDown Grid.Row="7"
         Width="150"
         Margin="0 5 0 15"
         x:Name="PCRTestsMainBlockSize"/>


        <TextBlock Margin="5" HorizontalAlignment="Center" Grid.Row="8" Text="Overflow file block size (bytes):" />

        <xctk:IntegerUpDown Grid.Row="9"
         Width="150"
         Margin="0 5 0 15"
         x:Name="PCRTestsOverflowBlockSize"/>

        <Button Grid.Row="10" Name="CreateFileButton"
        Content="Create new"
        Width="200"
        Click="CreateFileButton_Click"
        VerticalAlignment="Center"/>
    </Grid>
</Window>
