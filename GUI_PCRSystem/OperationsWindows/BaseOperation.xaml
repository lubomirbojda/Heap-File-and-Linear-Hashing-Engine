<Window x:Class="GUI_PCRSystem.OperationsWindows.BaseOperation"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_PCRSystem.OperationsWindows"
        mc:Ignorable="d"
        Title="BaseOperation" Height="450" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Margin="10" Grid.Row="0" VerticalAlignment="Center" Text="Person: " FontWeight="Bold" FontSize="15"/>

        <ListView Grid.Row="1" Margin="5" x:Name="PersonsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="First name" DisplayMemberBinding="{Binding FirstName}" Width="150"/>
                    <GridViewColumn Header="Last name" DisplayMemberBinding="{Binding LastName}" Width="150"/>
                    <GridViewColumn Header="Birthdate" DisplayMemberBinding="{Binding BirthDate}" Width="150"/>
                    <GridViewColumn Header="Person ID" DisplayMemberBinding="{Binding Id}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>

        <TextBlock Margin="10" Grid.Row="2" VerticalAlignment="Center" Text="PCR tests: " FontWeight="Bold" FontSize="15"/>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition/>
                <ColumnDefinition Width="85*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Margin="5,0,5,0" VerticalAlignment="Center" Text="Count: "/>
            <TextBlock x:Name="PCRTestsCountBox" Grid.Column="2" VerticalAlignment="Center" Text="0"/>
        </Grid>


        <ListView Grid.Row="4" Margin="5" x:Name="PCRTestsListView">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Date and time" DisplayMemberBinding="{Binding TestDateTime}" Width="150"/>
                    <GridViewColumn Header="Person ID" DisplayMemberBinding="{Binding PersonId}" Width="150"/>
                    <GridViewColumn Header="Test code" DisplayMemberBinding="{Binding TestCode}" Width="150"/>
                    <GridViewColumn Header="Result" DisplayMemberBinding="{Binding Result}" Width="100"/>
                    <GridViewColumn Header="Value" DisplayMemberBinding="{Binding Value}" Width="150"/>
                    <GridViewColumn Header="Note" DisplayMemberBinding="{Binding Note}" Width="150"/>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Window>
