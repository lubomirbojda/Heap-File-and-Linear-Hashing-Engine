<Window x:Class="GUI_PCRSystem.OperationsWindows.FindPersonAndTests"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_PCRSystem.OperationsWindows"
        mc:Ignorable="d"
        Title="FindPersonAndTests" Height="150" Width="300">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Person ID:" Margin="15"/>
        <TextBox Grid.Row="0" Grid.Column="1" Height="25" Margin="5" x:Name="PersonIDBox" VerticalContentAlignment="Center"/>

        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Margin="10" HorizontalAlignment="Right">
            <Button Content="Find" Width="80" Height="25" VerticalAlignment="Bottom" Margin="5" />
            <Button Content="Cancel" Width="80" Height="25" HorizontalAlignment="Right" Margin="5" VerticalAlignment="Bottom" />
        </StackPanel>
    </Grid>
</Window>
