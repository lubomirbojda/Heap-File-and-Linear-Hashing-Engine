<Window x:Class="GUI_HeapFIle.OperationsWindows.FoundPersonWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GUI_HeapFIle.OperationsWindows"
        mc:Ignorable="d"
        Title="FoundPersonWindow" Height="100" Width="500">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <TextBox Grid.Row="0" Margin="5" x:Name="PersonBox"/>
        <Button Grid.Row="1" Content="Close" Margin="5" Click="CloseButton_Click"/>
    </Grid>
</Window>
